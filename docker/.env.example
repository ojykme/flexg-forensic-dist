# [SECURITY] DO NOT COMMIT REAL KEYS TO GIT
# 실제 키값은 .env 파일에 작성하고, 이 파일(.env.example)은 템플릿으로만 사용하세요.

# 1. Forensic Core Settings
DNA_SECRET_KEY=your_super_secret_stego_key_here
FORENSIC_API_KEY=flexg_test_key_2024

# 2. Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flexg_forensic
DB_USER=postgres
DB_PASSWORD=your_password_here

# 3. Infrastructure Settings
REDIS_URL=redis://localhost:6379/0

# 4. Storage Settings (Object Storage)
STORAGE_ENDPOINT=https://jp-osa-1.linodeobjects.com
STORAGE_BUCKET=flexg-forensic-assets
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key

# 5. Infrastructure Settings (Docker/Caddy/Linode)
DOMAIN=forensic.ciri.kr
ADMIN_EMAIL=admin@ciri.kr

# Linode DNS API for Automated Provisioning
LINODE_API_TOKEN=your_linode_api_token_here
LINODE_DOMAIN_ID=your_target_domain_zone_id