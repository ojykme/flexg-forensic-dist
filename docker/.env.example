# [ENTERPRISE] FlexG Forensic Node Configuration

# Branding
PROJECT_NAME="FlexG Forensic Service"
BRAND_PREFIX="flexg"
BRAND_UI_NAME="FlexG Forensic"

# Security
DNA_SECRET_KEY=change_this_to_a_long_random_string
FORENSIC_API_KEY=change_this_to_a_long_random_string

# Database
DB_NAME=flexg_forensic
DB_USER=postgres
DB_PASSWORD=postgres_password_change_me

# Infrastructure
REDIS_URL=redis://redis:6379/0

# Storage (Object Storage Recommended)
STORAGE_ENDPOINT=https://your-object-storage.com
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# Caddy (HTTPS)
DOMAIN=your-domain.com
ADMIN_EMAIL=admin@your-domain.com
