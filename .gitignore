# [DISTRIBUTION] Git Ignore
# 원본 소스 코드 유출 방지를 위한 엄격한 필터링

# OS/IDE
.DS_Store
.vscode/
.idea/

# Environment
.env
*.lic
*.key

# Data & Logs
data/
logs/

# Python Raw Sources (원천 차단)
**/*.py

# Compiled files
__pycache__/
*.pyc
*.so
*.pyd

# Binary builds
dist/
build/

# 난독화된 bin 폴더 하위 파일 전체 예외 허용 (우선순위를 위해 최하단 배치)
!bin/
!bin/**/*
